{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "lindam",
	"compatibility_date": "2026-10-17",
	"main": "worker.js",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "none"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_ROOM",
				"class_name": "ChatRoom"
			}
		]
	},
	// Initial administrator credentials are Cloudflare Worker secrets, not source:
	// npx wrangler secret put ADMIN_BOOTSTRAP_USERNAME
	// npx wrangler secret put ADMIN_BOOTSTRAP_PASSWORD
	// Optionally set ADMIN_BOOTSTRAP_EMAIL for account contact details.
	// npx wrangler secret put ADMIN_BOOTSTRAP_EMAIL
	// Square production payments stay unavailable until Square credentials are configured:
	// npx wrangler secret put SQUARE_ACCESS_TOKEN
	// npx wrangler secret put SQUARE_WEBHOOK_SIGNATURE_KEY
	// Set SQUARE_LOCATION_ID as a Worker variable in Cloudflare.
	// SQUARE_WEBHOOK_NOTIFICATION_URL must exactly match the webhook URL in Square.
	// MFA is optional and off by default. Email MFA requires the EMAIL binding and a working SENDER_EMAIL.
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],
	// Check enabled appointment reminders once per minute.
	"triggers": {
		"crons": ["* * * * *"]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"ChatRoom"
			]
		}
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		}
	},
	"vars": {
		"FORWARD_TO_EMAIL": "klucinaken@gmail.com",
		"SENDER_EMAIL": "lindasappointments@klutchplay.com",
		"PUBLIC_SITE_URL": "https://lindam.klutchplay.com",
		"SQUARE_WEBHOOK_NOTIFICATION_URL": "https://lindam.klutchplay.com/api/square/webhook"
	},
	"routes": [
		{
			"pattern": "lindam.klutchplay.com",
			"zone_name": "klutchplay.com",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	]
}